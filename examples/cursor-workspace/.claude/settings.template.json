  "enabledMcpjsonServers": [
    "concept-rag",
    "atlassian",
    "workflow-server",
    "gitnexus"
  ],
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 __WORKSPACE__/scripts/claude/hooks/block-gh-api-writes.py",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 __WORKSPACE__/scripts/claude/hooks/compound-bash-allow.py",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 __WORKSPACE__/scripts/claude/hooks/block-dynamic-shell.py",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 __WORKSPACE__/scripts/claude/hooks/curl-read-allow.py",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 __WORKSPACE__/scripts/claude/hooks/redirect-inline-eval.py",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 __WORKSPACE__/scripts/claude/hooks/redirect-fs-mutation.py",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "WebFetch",
        "hooks": [
          {
            "type": "command",
            "command": "python3 __WORKSPACE__/scripts/claude/hooks/webfetch-allow.py",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "rust-analyzer-lsp@claude-plugins-official": true
  },
  "switchModelsOnFlag": true
}
