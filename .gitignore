# Dependencies
node_modules/

# Nested feature worktrees (per-checkout parent; not $INSTALL/worktrees)
.worktrees/

# Local checkout of the workflows branch. Not a gitlink; add with
# `git worktree add ./workflows workflows`.
/workflows

# Build output
dist/

# Cached merge-base guard results, keyed by (base commit, base corpus commit) — check:delta
.guard-cache/

# IDE
.idea/
.vscode/
*.swp
*.swo

# Agent skills, rules and settings — owned at workspace level, one home per machine
.claude/

# Environment
.env
.env.local
.env.*.local
.gitnexus
