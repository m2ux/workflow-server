# Dependencies
node_modules/

# Nested worktrees (per-checkout parent; not $INSTALL/worktrees). The
# `workflows` branch dest is `.worktrees/workflows`.
.worktrees/

# A corpus bound at the checkout root rather than under .worktrees — the walk writes its snapshot
# beside the definitions, so running that suite in a checkout leaves generated output here. Nothing
# tracked has ever lived at this path; the corpus is a branch of its own.
/workflows/

# Build output
dist/

# Cached merge-base guard results, keyed by (base commit, base corpus commit) — check:delta
.guard-cache/

# IDE
.idea/
.vscode/
*.swp
*.swo

# Agent skills, rules and settings — owned at workspace level, one home per machine
.claude/

# Environment
.env
.env.local
.env.*.local
.gitnexus
