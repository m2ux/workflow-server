{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "session-file",
  "description": "Session state recorded in session.json.",
  "$ref": "#/definitions/session-file",
  "definitions": {
    "session-file": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "number",
          "const": 1,
          "description": "Session file format version."
        },
        "sessionIndex": {
          "type": "string",
          "pattern": "^[A-Z2-7]{6}$",
          "description": "Six-character RFC 4648 base32 session identifier."
        },
        "workflowId": {
          "type": "string",
          "minLength": 1,
          "description": "Nonempty workflow identifier."
        },
        "workflowVersion": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$",
          "description": "Workflow version in numeric `major.minor.patch` form."
        },
        "agentId": {
          "type": "string",
          "minLength": 1,
          "description": "Nonempty identifier of the agent associated with this session."
        },
        "seq": {
          "type": "integer",
          "minimum": 0,
          "description": "Nonnegative integer revision number for the session state."
        },
        "ts": {
          "type": "integer",
          "minimum": 0,
          "description": "Time of the latest state revision, in Unix epoch seconds."
        },
        "startedAt": {
          "type": "string",
          "format": "date-time",
          "description": "ISO 8601 timestamp when the session began."
        },
        "frontier": {
          "type": "array",
          "items": {
            "type": "string",
            "description": "Activity identifier, optionally qualified by an instance number."
          },
          "default": [],
          "description": "Activities currently in progress, with parallel instances named `<activityId>#<instance>`."
        },
        "currentTechnique": {
          "type": "string",
          "default": "",
          "description": "Current technique reference, or an empty string when none is selected."
        },
        "exit": {
          "type": "string",
          "default": "",
          "description": "Most recent activity exit, or an empty string when none is recorded."
        },
        "activeCheckpoint": {
          "type": "object",
          "properties": {
            "checkpointId": {
              "type": "string",
              "minLength": 1,
              "description": "Nonempty identifier of the outstanding checkpoint."
            },
            "activityId": {
              "type": "string",
              "minLength": 1,
              "description": "Nonempty identifier of the activity containing the checkpoint."
            },
            "yieldedAt": {
              "type": "string",
              "format": "date-time",
              "description": "ISO 8601 timestamp when the checkpoint became outstanding."
            },
            "adhoc": {
              "type": "object",
              "properties": {
                "message": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Nonempty question or decision prompt."
                },
                "options": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string",
                        "minLength": 1,
                        "description": "Nonempty option identifier."
                      },
                      "label": {
                        "type": "string",
                        "minLength": 1,
                        "description": "Nonempty label for the choice."
                      },
                      "description": {
                        "type": "string",
                        "description": "Explanation of the choice."
                      }
                    },
                    "required": [
                      "id",
                      "label"
                    ],
                    "additionalProperties": false,
                    "description": "Named choice for the ad hoc decision."
                  },
                  "minItems": 2,
                  "description": "At least two choices for the ad hoc decision."
                }
              },
              "required": [
                "message",
                "options"
              ],
              "additionalProperties": false,
              "description": "Decision details for a checkpoint absent from the activity definition."
            }
          },
          "required": [
            "checkpointId",
            "activityId",
            "yieldedAt"
          ],
          "additionalProperties": false,
          "description": "Outstanding checkpoint and any ad hoc decision details."
        },
        "variables": {
          "type": "object",
          "additionalProperties": {
            "description": "Current value of the named variable."
          },
          "default": {},
          "description": "Current values keyed by variable name."
        },
        "completedActivities": {
          "type": "array",
          "items": {
            "type": "string",
            "description": "Identifier of a completed activity."
          },
          "default": [],
          "description": "Identifiers of completed activities."
        },
        "checkpointResponses": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "optionId": {
                "type": "string",
                "description": "Identifier of the selected option."
              },
              "respondedAt": {
                "type": "string",
                "format": "date-time",
                "description": "ISO 8601 timestamp of the response."
              },
              "effects": {
                "type": "object",
                "properties": {
                  "variablesSet": {
                    "type": "object",
                    "additionalProperties": {
                      "description": "Value assigned to the named variable."
                    },
                    "description": "Assigned values keyed by variable name."
                  },
                  "exit": {
                    "type": "string",
                    "description": "Activity exit named by the selected option."
                  }
                },
                "additionalProperties": false,
                "description": "Variable assignments and activity exit associated with the response."
              }
            },
            "required": [
              "optionId",
              "respondedAt"
            ],
            "additionalProperties": false,
            "description": "Recorded checkpoint choice, response time, and effects."
          },
          "default": {},
          "description": "Checkpoint decisions keyed by `activityId-checkpointId`."
        },
        "history": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "timestamp": {
                "type": "string",
                "format": "date-time",
                "description": "ISO 8601 timestamp of the event."
              },
              "type": {
                "type": "string",
                "enum": [
                  "workflow_started",
                  "workflow_completed",
                  "workflow_aborted",
                  "workflow_triggered",
                  "workflow_returned",
                  "workflow_suspended",
                  "activity_entered",
                  "activity_exited",
                  "activity_skipped",
                  "step_started",
                  "step_completed",
                  "checkpoint_reached",
                  "checkpoint_response",
                  "checkpoint_replayed",
                  "decision_reached",
                  "decision_branch_taken",
                  "loop_started",
                  "loop_iteration",
                  "loop_completed",
                  "loop_break",
                  "variable_set",
                  "error",
                  "technique_fetched",
                  "resource_fetched",
                  "technique_bundled",
                  "variables_seeded",
                  "activity_usage",
                  "activity_dispatched",
                  "activity_redelivered",
                  "batch_refused",
                  "activity_outcome",
                  "progress_published",
                  "activity_delivered"
                ],
                "description": "Category of the recorded session event."
              },
              "activity": {
                "type": "string",
                "description": "Activity identifier associated with the event."
              },
              "step": {
                "type": "integer",
                "minimum": 1,
                "description": "One-based integer step index."
              },
              "checkpoint": {
                "type": "string",
                "description": "Checkpoint identifier associated with the event."
              },
              "decision": {
                "type": "string",
                "description": "Decision identifier associated with the event."
              },
              "loop": {
                "type": "string",
                "description": "Loop identifier associated with the event."
              },
              "data": {
                "type": "object",
                "additionalProperties": {
                  "description": "Value of a named event detail."
                },
                "description": "Additional values describing the event."
              },
              "error": {
                "type": "object",
                "properties": {
                  "message": {
                    "type": "string",
                    "description": "Explanation of the error."
                  },
                  "code": {
                    "type": "string",
                    "description": "Identifier for the error category."
                  }
                },
                "required": [
                  "message"
                ],
                "additionalProperties": false,
                "description": "Error message and optional code."
              }
            },
            "required": [
              "timestamp",
              "type"
            ],
            "additionalProperties": false,
            "description": "Timestamped record of session progress or an error."
          },
          "default": [],
          "description": "Chronological record of session progress."
        },
        "status": {
          "type": "string",
          "enum": [
            "running",
            "completed",
            "aborted"
          ],
          "default": "running",
          "description": "Session status, defaulting to `running`."
        },
        "triggeredWorkflows": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "workflowId": {
                "type": "string",
                "minLength": 1,
                "description": "Nonempty identifier of the child workflow."
              },
              "sessionIndex": {
                "type": "string",
                "pattern": "^[A-Z2-7]{6}$",
                "description": "Six-character RFC 4648 base32 identifier of the child session."
              },
              "triggeredAt": {
                "type": "string",
                "format": "date-time",
                "description": "ISO 8601 timestamp when the child workflow began."
              },
              "triggeredFrom": {
                "type": "object",
                "properties": {
                  "activityId": {
                    "type": "string",
                    "description": "Identifier of the parent activity."
                  },
                  "stepIndex": {
                    "type": "integer",
                    "minimum": 1,
                    "description": "One-based index of the parent step."
                  }
                },
                "required": [
                  "activityId"
                ],
                "additionalProperties": false,
                "description": "Activity and optional step where the child workflow began."
              },
              "status": {
                "type": "string",
                "enum": [
                  "running",
                  "completed",
                  "aborted",
                  "error"
                ],
                "description": "Current status of the child workflow."
              },
              "completedAt": {
                "type": "string",
                "format": "date-time",
                "description": "ISO 8601 timestamp when the child workflow completed."
              },
              "state": {
                "$ref": "#/definitions/session-file",
                "description": "Full nested state of the child session."
              }
            },
            "required": [
              "workflowId",
              "sessionIndex",
              "triggeredAt",
              "triggeredFrom",
              "status"
            ],
            "additionalProperties": false,
            "description": "Child workflow reference with optional nested state."
          },
          "default": [],
          "description": "Child workflows and their optional nested session state."
        },
        "planningFolderPath": {
          "type": "string",
          "description": "Absolute path of the planning folder containing the session file."
        },
        "repo": {
          "type": "string",
          "minLength": 1,
          "description": "Target repository in `owner/repo` form."
        },
        "contextMode": {
          "type": "string",
          "enum": [
            "persistent",
            "fresh"
          ],
          "description": "Context lifetime: `persistent` across calls, or `fresh` for each call by default."
        },
        "executionPath": {
          "type": "string",
          "enum": [
            "agent",
            "runner"
          ],
          "description": "Execution mode: `agent` by default, or `runner`."
        },
        "deliveredContent": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "description": "Fingerprint of the content associated with this key."
            },
            "description": "Content keys mapped to fingerprints for one agent."
          },
          "description": "Content fingerprints grouped by agent identifier and content key."
        },
        "declaredArtifacts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "description": "Nonempty artifact identifier."
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "description": "Nonempty artifact filename."
              },
              "path": {
                "type": "string",
                "description": "Location of the artifact file."
              }
            },
            "required": [
              "id",
              "name"
            ],
            "additionalProperties": false,
            "description": "Artifact identifier, filename, and optional path."
          },
          "description": "Artifacts declared during the session."
        }
      },
      "required": [
        "schemaVersion",
        "sessionIndex",
        "workflowId",
        "workflowVersion",
        "agentId",
        "seq",
        "ts",
        "startedAt"
      ],
      "additionalProperties": false,
      "description": "Session identity, progress, variables, decisions, and child sessions."
    }
  }
}
