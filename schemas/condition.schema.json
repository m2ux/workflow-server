{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "condition",
  "description": "Condition expression schema",
  "$ref": "#/definitions/condition",
  "definitions": {
    "condition": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "simple",
              "description": "Identifies a variable comparison or presence test."
            },
            "variable": {
              "type": "string",
              "description": "Variable name or dot-separated path to the value to test; a path through a missing or non-object segment reads as absent."
            },
            "operator": {
              "type": "string",
              "enum": [
                "==",
                "!=",
                ">",
                "<",
                ">=",
                "<=",
                "exists",
                "notExists"
              ],
              "description": "Comparison or presence test applied to a variable. `==` and `!=` compare strictly, without type coercion. `>`, `<`, `>=` and `<=` compare numbers and numeric strings, and are false when either side is anything else. `exists` holds when the value is present and not null; `notExists` holds when it is absent or null."
            },
            "value": {
              "type": [
                "string",
                "number",
                "boolean",
                "null"
              ],
              "description": "Comparison value; unnecessary for `exists` and `notExists` tests."
            }
          },
          "required": [
            "type",
            "variable",
            "operator"
          ],
          "additionalProperties": false,
          "description": "Comparison of a variable with a value, or a test of its presence."
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "and",
              "description": "Identifies an all-members condition."
            },
            "conditions": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/condition"
              },
              "minItems": 2,
              "description": "At least two conditions that must all be true."
            }
          },
          "required": [
            "type",
            "conditions"
          ],
          "additionalProperties": false,
          "description": "Condition requiring every member to be true."
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "or",
              "description": "Identifies an any-member condition."
            },
            "conditions": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/condition"
              },
              "minItems": 2,
              "description": "At least two conditions, one or more of which must be true."
            }
          },
          "required": [
            "type",
            "conditions"
          ],
          "additionalProperties": false,
          "description": "Condition requiring at least one member to be true."
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "not",
              "description": "Identifies a negated condition."
            },
            "condition": {
              "$ref": "#/definitions/condition",
              "description": "Condition that must be false."
            }
          },
          "required": [
            "type",
            "condition"
          ],
          "additionalProperties": false,
          "description": "Condition requiring its member to be false."
        }
      ],
      "description": "Variable test or combination of conditions using `and`, `or`, or `not`."
    }
  }
}
