{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "technique",
  "description": "Technique capability with inputs, protocol, rules, and outputs.",
  "$ref": "#/definitions/technique",
  "definitions": {
    "technique": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "capability": {
          "type": "string"
        },
        "provenance_note": {
          "type": "string",
          "description": "Input and output provenance annotation; omitted from authored technique files."
        },
        "rules": {
          "type": "object",
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string",
                "description": "Single rule text."
              },
              {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Array of related rules grouped under this key."
              }
            ]
          }
        },
        "inputs": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "description": "Stable input identifier with words separated by hyphens."
              },
              "description": {
                "type": "string",
                "description": "Input description, beginning with `(optional)` when the input is optional."
              },
              "default": {
                "description": "Default value when not supplied"
              },
              "components": {
                "type": "object",
                "additionalProperties": {
                  "anyOf": [
                    {
                      "type": "string",
                      "description": "Component specification or description."
                    },
                    {
                      "type": "object",
                      "properties": {
                        "description": {
                          "type": "string",
                          "description": "Component description above its first `#####` field heading."
                        },
                        "entry": {
                          "type": "object",
                          "additionalProperties": {
                            "type": "string"
                          },
                          "description": "Field identifiers mapped to descriptions for each list entry, authored as `#####` headings."
                        }
                      },
                      "required": [
                        "entry"
                      ],
                      "additionalProperties": false
                    }
                  ]
                },
                "description": "Named parts of a composite input, authored as `####` headings."
              },
              "source": {
                "type": "string",
                "description": "Input value source annotation; omitted from authored technique files."
              }
            },
            "required": [
              "id"
            ],
            "additionalProperties": false
          },
          "description": "Named inputs accepted by the technique."
        },
        "inherited_inputs": {
          "type": "object",
          "properties": {
            "note": {
              "type": "string",
              "description": "Brief explanation of the shared input scope."
            },
            "items": {
              "$ref": "#/definitions/technique/properties/inputs"
            }
          },
          "required": [
            "note",
            "items"
          ],
          "additionalProperties": false,
          "description": "Shared inputs from the workflow or group contract; omitted from authored technique files."
        },
        "protocol": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "title": {
                "type": "string",
                "description": "Block label, authored as a `###` heading."
              },
              "steps": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Ordered imperative step bullets for this block."
              }
            },
            "required": [
              "steps"
            ],
            "additionalProperties": false
          }
        },
        "outputs": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "description": "Stable output identifier with words separated by hyphens, distinct from its artifact filename."
              },
              "description": {
                "type": "string",
                "description": "Human-readable description of this output"
              },
              "components": {
                "$ref": "#/definitions/technique/properties/inputs/items/properties/components",
                "description": "Component identifiers mapped to descriptions or list-entry field definitions."
              },
              "entry": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                },
                "description": "List-entry fields under `#### entry` with `#####` field headings; mutually exclusive with `components`."
              },
              "artifact": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "pattern": "^(?:[A-Za-z0-9._-]|\\{[A-Za-z0-9._$-]+\\})+\\.[A-Za-z0-9]+$",
                    "description": "Single artifact filename with an extension and optional `{variable}` placeholders; declare one output per artifact."
                  },
                  "action": {
                    "type": "string",
                    "enum": [
                      "create",
                      "update"
                    ],
                    "default": "create",
                    "description": "Whether this output creates a new artifact or updates an existing one"
                  }
                },
                "required": [
                  "name"
                ],
                "additionalProperties": false,
                "description": "Filename and create-or-update action for a persisted output."
              },
              "audience": {
                "type": "string",
                "enum": [
                  "human",
                  "agent"
                ],
                "description": "Intended reader of this output or artifact: `human` by default, or `agent`."
              },
              "values": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "minItems": 1,
                "description": "Complete set of allowed output values, authored under `#### values`."
              },
              "fieldValues": {
                "type": "object",
                "additionalProperties": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "minItems": 1
                },
                "description": "Field names mapped to allowed value sets, authored as `#####` headings under `#### values`."
              },
              "destination": {
                "type": "string",
                "description": "Output variable name annotation when different from its identifier; omitted from authored technique files."
              }
            },
            "required": [
              "id"
            ],
            "additionalProperties": false
          },
          "description": "Named outputs with optional descriptions and either components or list-entry fields."
        },
        "inherited_outputs": {
          "type": "object",
          "properties": {
            "note": {
              "type": "string",
              "description": "Brief explanation of the shared output obligations."
            },
            "items": {
              "$ref": "#/definitions/technique/properties/outputs"
            }
          },
          "required": [
            "note",
            "items"
          ],
          "additionalProperties": false,
          "description": "Shared outputs from the workflow or group contract; omitted from authored technique files."
        }
      },
      "required": [
        "id",
        "version",
        "capability"
      ],
      "additionalProperties": false
    }
  }
}
