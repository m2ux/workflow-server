{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "workflow",
  "description": "Workflow definition schema",
  "$ref": "#/definitions/workflow",
  "definitions": {
    "workflow": {
      "type": "object",
      "properties": {
        "$schema": {
          "type": "string",
          "description": "URI of the JSON Schema for this workflow definition."
        },
        "id": {
          "type": "string",
          "description": "Unique workflow identifier"
        },
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$",
          "description": "Semantic version"
        },
        "title": {
          "type": "string",
          "description": "Human-readable workflow title"
        },
        "description": {
          "type": "string",
          "description": "Detailed workflow description"
        },
        "author": {
          "type": "string",
          "description": "Workflow author."
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string",
            "description": "Workflow classification label."
          },
          "description": "Labels for classifying the workflow."
        },
        "rules": {
          "type": "object",
          "properties": {
            "workflow": {
              "type": "array",
              "items": {
                "type": "string",
                "description": "Rule for the workflow orchestrator."
              },
              "description": "Rules for the workflow orchestrator."
            },
            "activity": {
              "type": "array",
              "items": {
                "type": "string",
                "description": "Rule for every activity worker."
              },
              "description": "Rules for the workers executing each activity."
            },
            "universal": {
              "type": "array",
              "items": {
                "type": "string",
                "description": "Rule for both the orchestrator and activity workers."
              },
              "description": "Rules for both the orchestrator and activity workers."
            }
          },
          "additionalProperties": false,
          "description": "Rules grouped by audience: workflow orchestrator, activity workers, or both."
        },
        "variables": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9]*(_[a-z0-9]+)+$",
                    "description": "Snake_case noun phrase containing at least two words."
                  },
                  {
                    "type": "string",
                    "enum": [
                      "requirements",
                      "features",
                      "exclusions",
                      "dimensions",
                      "tasks",
                      "results",
                      "submodules",
                      "paths",
                      "fields",
                      "filters",
                      "stats",
                      "effects",
                      "substitutions",
                      "findings",
                      "assumptions",
                      "subsystems",
                      "transitions",
                      "options",
                      "branches",
                      "agents",
                      "changes",
                      "failures",
                      "items",
                      "files",
                      "gaps",
                      "outcomes",
                      "body",
                      "query",
                      "repo",
                      "owner",
                      "number",
                      "title",
                      "branch",
                      "diff",
                      "limit",
                      "name",
                      "sha",
                      "url",
                      "head",
                      "base",
                      "ref",
                      "labels",
                      "path",
                      "cursor",
                      "cql",
                      "jql",
                      "description",
                      "assignee",
                      "depth",
                      "direction",
                      "summary",
                      "state",
                      "target",
                      "adr",
                      "type",
                      "mode",
                      "kind"
                    ],
                    "description": "Permitted single-word variable name."
                  }
                ],
                "description": "Snake_case noun phrase of at least two words, or a listed single-word exemption."
              },
              "type": {
                "type": "string",
                "enum": [
                  "string",
                  "number",
                  "boolean",
                  "array",
                  "object"
                ],
                "description": "Declared variable type."
              },
              "description": {
                "type": "string",
                "description": "Meaning and intended use of the variable."
              },
              "values": {
                "type": "array",
                "items": {
                  "type": "string",
                  "description": "Allowed string value for the variable."
                },
                "minItems": 1,
                "description": "Nonempty set of distinct allowed string values, including the default when one is declared."
              },
              "defaultValue": {
                "description": "Initial variable value; a defaulted variable is already present at the start of a session."
              },
              "required": {
                "type": "boolean",
                "default": false,
                "description": "Whether the workflow requires a value for this variable."
              }
            },
            "required": [
              "name",
              "type"
            ],
            "additionalProperties": false,
            "description": "Variable declaration with type, allowed values, and an optional initial value."
          },
          "description": "Declarations of session facts and policy shared across activities; activity-produced variables belong in that activity's `variables.writes`."
        },
        "techniques": {
          "type": "object",
          "properties": {
            "workflow": {
              "type": "array",
              "items": {
                "type": "string",
                "description": "Technique reference for workflow orchestration."
              },
              "description": "Technique references for workflow orchestration, using `::`-separated paths."
            },
            "activity": {
              "type": "array",
              "items": {
                "type": "string",
                "description": "Technique reference shared by every activity."
              },
              "description": "Technique references that apply to every activity."
            }
          },
          "additionalProperties": false,
          "description": "Technique references grouped by scope: workflow orchestration or every activity."
        },
        "initialActivity": {
          "type": "string",
          "description": "Identifier of the first activity to execute."
        },
        "graph": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": {
              "anyOf": [
                {
                  "type": "string",
                  "description": "Destination activity identifier, or `__terminal__` to end the workflow."
                },
                {
                  "type": "array",
                  "items": {
                    "anyOf": [
                      {
                        "type": "string",
                        "description": "Identifier of an activity to run once."
                      },
                      {
                        "type": "object",
                        "properties": {
                          "activity": {
                            "type": "string",
                            "description": "Activity identifier to run once per collection element."
                          },
                          "over": {
                            "type": "string",
                            "description": "Collection variable name or dotted path, such as `work_units` or `execution_plan.steps`."
                          },
                          "variable": {
                            "anyOf": [
                              {
                                "$ref": "#/definitions/workflow/properties/variables/items/properties/name/anyOf/0"
                              },
                              {
                                "$ref": "#/definitions/workflow/properties/variables/items/properties/name/anyOf/1"
                              }
                            ],
                            "description": "Variable name for each collection element, declared among the activity's required inputs."
                          },
                          "maxInstances": {
                            "type": "integer",
                            "minimum": 2,
                            "description": "Maximum number of parallel instances for this destination, at least two."
                          }
                        },
                        "required": [
                          "activity",
                          "over",
                          "variable"
                        ],
                        "additionalProperties": false,
                        "description": "Activity repeated in parallel for each element of a collection."
                      }
                    ],
                    "description": "One parallel activity or an activity repeated over a collection."
                  },
                  "minItems": 2,
                  "description": "At least two parallel activities or collection instances with a common next activity."
                },
                {
                  "$ref": "#/definitions/workflow/properties/graph/additionalProperties/additionalProperties/anyOf/1/items/anyOf/1"
                }
              ],
              "description": "Next activity, terminal outcome, or parallel group of activities or collection instances."
            },
            "description": "Exit identifiers mapped to destinations for one activity."
          },
          "description": "Activity identifiers mapped to exit identifiers and their destinations: an activity, `__terminal__`, or parallel activities or collection instances. Required when activities declare exits."
        },
        "activities": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "description": "Unique identifier for the activity"
              },
              "version": {
                "type": "string",
                "pattern": "^\\d+\\.\\d+\\.\\d+$",
                "description": "Semantic version of the activity"
              },
              "name": {
                "type": "string",
                "description": "Human-readable activity name"
              },
              "description": {
                "type": "string",
                "description": "Detailed description of the activity"
              },
              "variables": {
                "type": "object",
                "properties": {
                  "reads": {
                    "type": "array",
                    "items": {
                      "$ref": "#/definitions/workflow/properties/variables/items/properties/name"
                    },
                    "description": "Session variable names required from outside this activity; values produced by its earlier steps are local."
                  },
                  "writes": {
                    "type": "array",
                    "items": {
                      "$ref": "#/definitions/workflow/properties/variables/items"
                    },
                    "description": "Declarations for session variables written by this activity."
                  }
                },
                "additionalProperties": false,
                "description": "Session variable names required by this activity and declarations for the variables it writes."
              },
              "techniques": {
                "type": "array",
                "items": {
                  "type": "string",
                  "description": "Technique reference using a `::`-separated path."
                },
                "description": "Activity-wide technique references, using `::`-separated paths."
              },
              "bundleTechniques": {
                "type": "object",
                "properties": {
                  "maxChars": {
                    "type": "integer",
                    "minimum": 0,
                    "description": "Maximum characters per step technique included with the activity; zero excludes all step techniques."
                  }
                },
                "required": [
                  "maxChars"
                ],
                "additionalProperties": false,
                "description": "Optional character limit for inline step techniques."
              },
              "steps": {
                "type": "array",
                "items": {
                  "anyOf": [
                    {
                      "type": "object",
                      "properties": {
                        "kind": {
                          "type": "string",
                          "const": "technique",
                          "description": "Step-kind discriminator."
                        },
                        "id": {
                          "type": "string",
                          "description": "Step identifier, defaulting to the last `::` segment of its technique reference."
                        },
                        "technique": {
                          "anyOf": [
                            {
                              "type": "string",
                              "description": "Technique reference using a `::`-separated path."
                            },
                            {
                              "type": "object",
                              "properties": {
                                "name": {
                                  "type": "string",
                                  "description": "Technique reference, such as `group::technique` or `workflow::group::technique`."
                                },
                                "inputs": {
                                  "type": "object",
                                  "additionalProperties": {
                                    "type": [
                                      "string",
                                      "number",
                                      "boolean"
                                    ],
                                    "description": "Variable name, literal value, or template expression for an input."
                                  },
                                  "description": "Input identifiers mapped to variable names, literals, or `{template}` expressions where the binding differs from the input name or default."
                                },
                                "outputs": {
                                  "type": "object",
                                  "additionalProperties": {
                                    "type": "string",
                                    "description": "Workflow variable name for the output."
                                  },
                                  "description": "Output identifiers mapped to workflow variable names where the names differ."
                                }
                              },
                              "required": [
                                "name"
                              ],
                              "additionalProperties": false,
                              "description": "Technique reference with input and output bindings."
                            }
                          ],
                          "description": "Technique reference, or an object with `name` and optional `inputs` and `outputs` bindings."
                        },
                        "actions": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "action": {
                                "type": "string",
                                "enum": [
                                  "log",
                                  "validate",
                                  "set",
                                  "emit",
                                  "message"
                                ],
                                "description": "Action to perform."
                              },
                              "target": {
                                "type": "string",
                                "description": "Variable name or other target of the action."
                              },
                              "message": {
                                "type": "string",
                                "description": "Message associated with the action."
                              },
                              "value": {
                                "description": "Value assigned or supplied by the action."
                              },
                              "description": {
                                "type": "string",
                                "description": "Human-readable description of what this action does"
                              },
                              "condition": {
                                "anyOf": [
                                  {
                                    "type": "object",
                                    "properties": {
                                      "type": {
                                        "type": "string",
                                        "const": "simple",
                                        "description": "Identifies a variable comparison or presence test."
                                      },
                                      "variable": {
                                        "type": "string",
                                        "description": "Variable name or dot-separated path to the value to test."
                                      },
                                      "operator": {
                                        "type": "string",
                                        "enum": [
                                          "==",
                                          "!=",
                                          ">",
                                          "<",
                                          ">=",
                                          "<=",
                                          "exists",
                                          "notExists"
                                        ],
                                        "description": "Comparison or presence test applied to a variable."
                                      },
                                      "value": {
                                        "type": [
                                          "string",
                                          "number",
                                          "boolean",
                                          "null"
                                        ],
                                        "description": "Comparison value; unnecessary for `exists` and `notExists` tests."
                                      }
                                    },
                                    "required": [
                                      "type",
                                      "variable",
                                      "operator"
                                    ],
                                    "additionalProperties": false,
                                    "description": "Comparison of a variable with a value, or a test of its presence."
                                  },
                                  {
                                    "type": "object",
                                    "properties": {
                                      "type": {
                                        "type": "string",
                                        "const": "and",
                                        "description": "Identifies an all-members condition."
                                      },
                                      "conditions": {
                                        "type": "array",
                                        "items": {
                                          "$ref": "#/definitions/workflow/properties/activities/items/properties/steps/items/anyOf/0/properties/actions/items/properties/condition"
                                        },
                                        "minItems": 2,
                                        "description": "At least two conditions that must all be true."
                                      }
                                    },
                                    "required": [
                                      "type",
                                      "conditions"
                                    ],
                                    "additionalProperties": false,
                                    "description": "Condition requiring every member to be true."
                                  },
                                  {
                                    "type": "object",
                                    "properties": {
                                      "type": {
                                        "type": "string",
                                        "const": "or",
                                        "description": "Identifies an any-member condition."
                                      },
                                      "conditions": {
                                        "type": "array",
                                        "items": {
                                          "$ref": "#/definitions/workflow/properties/activities/items/properties/steps/items/anyOf/0/properties/actions/items/properties/condition"
                                        },
                                        "minItems": 2,
                                        "description": "At least two conditions, one or more of which must be true."
                                      }
                                    },
                                    "required": [
                                      "type",
                                      "conditions"
                                    ],
                                    "additionalProperties": false,
                                    "description": "Condition requiring at least one member to be true."
                                  },
                                  {
                                    "type": "object",
                                    "properties": {
                                      "type": {
                                        "type": "string",
                                        "const": "not",
                                        "description": "Identifies a negated condition."
                                      },
                                      "condition": {
                                        "$ref": "#/definitions/workflow/properties/activities/items/properties/steps/items/anyOf/0/properties/actions/items/properties/condition",
                                        "description": "Condition that must be false."
                                      }
                                    },
                                    "required": [
                                      "type",
                                      "condition"
                                    ],
                                    "additionalProperties": false,
                                    "description": "Condition requiring its member to be false."
                                  }
                                ],
                                "description": "Condition that must be true for this action to execute"
                              }
                            },
                            "required": [
                              "action"
                            ],
                            "additionalProperties": false,
                            "description": "Action with an optional target, value, message, and condition."
                          },
                          "description": "Actions associated with the technique step."
                        },
                        "when": {
                          "type": "string",
                          "description": "Boolean expression required to enter this step; mixed `&&` and `||` expressions require parentheses."
                        },
                        "required": {
                          "type": "boolean",
                          "const": false,
                          "description": "Declare `false` for an optional step; omission means the step is required."
                        },
                        "condition": {
                          "$ref": "#/definitions/workflow/properties/activities/items/properties/steps/items/anyOf/0/properties/actions/items/properties/condition",
                          "description": "Structured entry condition; a checkpoint may be dismissed when this condition is false."
                        }
                      },
                      "required": [
                        "kind",
                        "technique"
                      ],
                      "additionalProperties": false,
                      "description": "Step that invokes a technique with optional actions and entry conditions."
                    },
                    {
                      "type": "object",
                      "properties": {
                        "kind": {
                          "type": "string",
                          "const": "action",
                          "description": "Step-kind discriminator."
                        },
                        "id": {
                          "type": "string",
                          "description": "Identifier for this step within the activity."
                        },
                        "actions": {
                          "type": "array",
                          "items": {
                            "$ref": "#/definitions/workflow/properties/activities/items/properties/steps/items/anyOf/0/properties/actions/items"
                          },
                          "description": "Control actions; may be empty for marker steps."
                        },
                        "when": {
                          "$ref": "#/definitions/workflow/properties/activities/items/properties/steps/items/anyOf/0/properties/when"
                        },
                        "required": {
                          "$ref": "#/definitions/workflow/properties/activities/items/properties/steps/items/anyOf/0/properties/required"
                        },
                        "condition": {
                          "$ref": "#/definitions/workflow/properties/activities/items/properties/steps/items/anyOf/0/properties/condition"
                        }
                      },
                      "required": [
                        "kind",
                        "id"
                      ],
                      "additionalProperties": false,
                      "description": "Control step with optional actions and entry conditions."
                    },
                    {
                      "type": "object",
                      "properties": {
                        "kind": {
                          "type": "string",
                          "const": "checkpoint",
                          "description": "Step-kind discriminator."
                        },
                        "id": {
                          "type": "string",
                          "description": "Identifier for this checkpoint within the activity."
                        },
                        "message": {
                          "type": "string",
                          "description": "Message presented to the user."
                        },
                        "options": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "id": {
                                "type": "string",
                                "description": "Option identifier within the checkpoint."
                              },
                              "label": {
                                "type": "string",
                                "description": "Short label for the choice."
                              },
                              "description": {
                                "type": "string",
                                "description": "Explanation of the choice."
                              },
                              "effect": {
                                "type": "object",
                                "properties": {
                                  "setVariable": {
                                    "type": "object",
                                    "additionalProperties": {
                                      "description": "Value assigned to the named variable."
                                    },
                                    "description": "Variable assignments associated with selecting this option."
                                  },
                                  "exit": {
                                    "type": "string",
                                    "description": "Name from the owning activity's `exits`, omitted for an ad hoc checkpoint."
                                  }
                                },
                                "additionalProperties": false,
                                "description": "Variable assignments and activity exit associated with the choice."
                              }
                            },
                            "required": [
                              "id",
                              "label"
                            ],
                            "additionalProperties": false,
                            "description": "Checkpoint choice and its associated effects."
                          },
                          "minItems": 1,
                          "description": "Decision options with effects."
                        },
                        "defaultOption": {
                          "type": "string",
                          "description": "Option identifier to use when no person answers the checkpoint."
                        },
                        "autoAdvanceMs": {
                          "type": "integer",
                          "exclusiveMinimum": 0,
                          "description": "Positive waiting interval in milliseconds before the default option may be selected automatically."
                        },
                        "when": {
                          "$ref": "#/definitions/workflow/properties/activities/items/properties/steps/items/anyOf/0/properties/when"
                        },
                        "required": {
                          "$ref": "#/definitions/workflow/properties/activities/items/properties/steps/items/anyOf/0/properties/required"
                        },
                        "condition": {
                          "$ref": "#/definitions/workflow/properties/activities/items/properties/steps/items/anyOf/0/properties/condition"
                        }
                      },
                      "required": [
                        "kind",
                        "id",
                        "message",
                        "options"
                      ],
                      "additionalProperties": false,
                      "description": "User decision at a defined position in the activity steps."
                    },
                    {
                      "type": "object",
                      "properties": {
                        "kind": {
                          "type": "string",
                          "const": "loop",
                          "description": "Step-kind discriminator."
                        },
                        "id": {
                          "type": "string",
                          "description": "Identifier for this step within the activity."
                        },
                        "name": {
                          "type": "string",
                          "description": "Human-readable label for the iteration."
                        },
                        "loopType": {
                          "type": "string",
                          "enum": [
                            "forEach",
                            "while",
                            "doWhile"
                          ],
                          "description": "Iteration over a collection (`forEach`), with a pre-test (`while`), or with a post-test (`doWhile`)."
                        },
                        "continueWhile": {
                          "$ref": "#/definitions/workflow/properties/activities/items/properties/steps/items/anyOf/0/properties/actions/items/properties/condition",
                          "description": "Continuation condition required for `while` and `doWhile` loops and absent for `forEach` loops."
                        },
                        "variable": {
                          "type": "string",
                          "description": "Current-item variable bound each iteration."
                        },
                        "over": {
                          "type": "string",
                          "description": "Collection expression iterated by a forEach loop."
                        },
                        "breakCondition": {
                          "$ref": "#/definitions/workflow/properties/activities/items/properties/steps/items/anyOf/0/properties/actions/items/properties/condition",
                          "description": "Condition that ends a `forEach` loop before the next item; absent for `while` and `doWhile` loops."
                        },
                        "maxIterations": {
                          "type": "integer",
                          "exclusiveMinimum": 0,
                          "description": "Maximum number of iterations."
                        },
                        "steps": {
                          "type": "array",
                          "items": {
                            "$ref": "#/definitions/workflow/properties/activities/items/properties/steps/items",
                            "description": "Step within the loop body."
                          },
                          "description": "The loop body, a nested ordered list of steps."
                        },
                        "when": {
                          "$ref": "#/definitions/workflow/properties/activities/items/properties/steps/items/anyOf/0/properties/when"
                        },
                        "required": {
                          "$ref": "#/definitions/workflow/properties/activities/items/properties/steps/items/anyOf/0/properties/required"
                        }
                      },
                      "required": [
                        "kind",
                        "id",
                        "loopType",
                        "steps"
                      ],
                      "additionalProperties": false,
                      "description": "Loop with a `when` entry expression and a separate continuation test, without a `condition` field."
                    },
                    {
                      "type": "object",
                      "properties": {
                        "kind": {
                          "type": "string",
                          "const": "routine",
                          "description": "Step-kind discriminator."
                        },
                        "id": {
                          "type": "string",
                          "description": "Routine step identifier and prefix for identifiers within its body."
                        },
                        "routine": {
                          "type": "string",
                          "description": "Routine reference in `[namespace::]name` form, with a directory name or corpus-relative path as the namespace."
                        },
                        "with": {
                          "type": "object",
                          "additionalProperties": {
                            "type": [
                              "string",
                              "number",
                              "boolean"
                            ],
                            "description": "Literal argument or braced host-variable reference."
                          },
                          "description": "Routine input identifiers mapped to literal values or `{host_variable}` references; omitted arguments use declared defaults, then same-name host variables."
                        },
                        "outputs": {
                          "type": "object",
                          "additionalProperties": {
                            "type": "string",
                            "description": "Session variable name for the routine output."
                          },
                          "description": "Routine output identifiers mapped to session variable names; only outputs declared optional may be left unbound."
                        },
                        "when": {
                          "$ref": "#/definitions/workflow/properties/activities/items/properties/steps/items/anyOf/0/properties/when"
                        },
                        "required": {
                          "$ref": "#/definitions/workflow/properties/activities/items/properties/steps/items/anyOf/0/properties/required"
                        }
                      },
                      "required": [
                        "kind",
                        "id",
                        "routine"
                      ],
                      "additionalProperties": false,
                      "description": "Routine invocation with an optional `when` entry expression and no `condition` field."
                    }
                  ],
                  "description": "Step selected by `kind`, with guidance in its technique and no step-level `description` field."
                },
                "description": "Ordered steps, including checkpoints and loops inline; separate `checkpoints[]` and `loops[]` fields are not accepted."
              },
              "exits": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "description": "Kebab-case outcome name, unique within the activity and distinct from a destination activity identifier."
                    },
                    "label": {
                      "type": "string",
                      "description": "Human-readable statement of the outcome."
                    },
                    "when": {
                      "type": "string",
                      "description": "Boolean expression selecting this exit; omitted for default exits and exits selected only by checkpoint options."
                    },
                    "isDefault": {
                      "type": "boolean",
                      "const": true,
                      "description": "Declare `true` for the fallback when no condition or checkpoint selects an exit; required on exactly one exit when several exist."
                    },
                    "immediate": {
                      "type": "boolean",
                      "const": true,
                      "description": "Declare `true` to end the remaining steps when a checkpoint selects this exit; omission defers the exit until the steps finish."
                    }
                  },
                  "required": [
                    "id"
                  ],
                  "additionalProperties": false,
                  "description": "Named activity outcome with optional selection and completion conditions."
                },
                "description": "Named outcomes, each bound to a destination in the workflow graph; omission makes the activity terminal."
              },
              "triggers": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "workflow": {
                      "type": "string",
                      "description": "ID of the workflow to trigger"
                    },
                    "description": {
                      "type": "string",
                      "description": "When and why to trigger this workflow."
                    },
                    "passContext": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "description": "Name of a context variable to pass to the child workflow."
                      },
                      "description": "Context variable names to pass to the child workflow."
                    }
                  },
                  "required": [
                    "workflow"
                  ],
                  "additionalProperties": false,
                  "description": "Child workflow reference and context to pass to it."
                },
                "description": "Child workflows to start from this activity."
              },
              "outcome": {
                "type": "array",
                "items": {
                  "type": "string",
                  "description": "Expected result of successful activity completion."
                },
                "description": "Expected outcomes of successful activity completion."
              },
              "required": {
                "type": "boolean",
                "default": true,
                "description": "Whether this activity is required in the workflow"
              },
              "rules": {
                "type": "array",
                "items": {
                  "type": "string",
                  "description": "Rule or constraint for this activity."
                },
                "description": "Activity-level rules and constraints that agents must follow"
              },
              "artifactPrefix": {
                "type": "string",
                "description": "Numeric artifact filename prefix, such as `02`; omitted from authored activity definitions."
              }
            },
            "required": [
              "id",
              "version",
              "name"
            ],
            "additionalProperties": false,
            "description": "Activity with ordered steps; artifact contracts belong to the bound techniques, with no activity-level artifact-contract field."
          },
          "minItems": 1,
          "description": "Activities in this workflow; omitted when activities are defined in separate files."
        }
      },
      "required": [
        "id",
        "version",
        "title",
        "initialActivity"
      ],
      "additionalProperties": false,
      "description": "Workflow identity, shared declarations, activities, and exit destinations."
    }
  }
}
