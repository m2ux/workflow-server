{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "routine",
  "description": "Reusable steps with declared inputs, outputs, and internals.",
  "$ref": "#/definitions/routine",
  "definitions": {
    "whenExpression": {
      "type": "string",
      "description": "Inline boolean expression in the `when` dialect, evaluated against the current session variables. Grammar: `orExpr := andExpr ('||' andExpr)*`; `andExpr := unary ('&&' unary)*`; `unary := '!' unary | primary`; `primary := IDENT | comparison | 'true' | 'false' | '(' orExpr ')'`; `comparison := IDENT ('==' | '!=' | '>' | '<' | '>=' | '<=') literal`. Precedence, tightest first: `()`, `!`, comparisons, `&&`, `||`. Mixing `&&` and `||` at the same nesting depth requires parentheses, so grouping is always explicit: `(a && b) || c`, never `a && b || c`. An IDENT is a variable name or a dotted path into one (`execution_plan.status`): a letter or underscore, then letters, digits, underscores and dots. A literal is `true`, `false`, `null`, a single- or double-quoted string (a backslash escapes the next character), an integer with an optional leading `-`, or a bare word, which is a string (`analysis_type == completion`). Decimals are not literals. A bare IDENT holds when its value is truthy. A variable that is absent is undefined: it is falsy, `==` matches nothing (not even `null` or `false`), and `!=` matches every literal. `==` and `!=` compare strictly, without type coercion. `>`, `<`, `>=` and `<=` convert both sides to numbers and are false when either side is not a finite number. An expression that does not parse evaluates to false. Examples: `has_saved_state == true`, `remediation_round > 0`, `!is_review_mode`, `a == true && b != false`, `(a && b) || c`, `is_review_mode != true && (problem_complexity == \"moderate\" || problem_complexity == \"complex\")`."
    },
    "routine": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$",
          "description": "Unique kebab-case routine identifier, without `::`."
        },
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$",
          "description": "Semantic version of the routine"
        },
        "name": {
          "type": "string",
          "description": "Human-readable routine name"
        },
        "description": {
          "type": "string",
          "description": "What the run does, and when to refer to it"
        },
        "inputs": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9]*(_[a-z0-9]+)+$",
                    "description": "Qualified snake_case noun phrase of at least two words: a lowercase letter, then lowercase letters and digits, with each further word after a single underscore (`analysis_target`, never bare `target`)."
                  },
                  {
                    "type": "string",
                    "enum": [
                      "requirements",
                      "features",
                      "exclusions",
                      "dimensions",
                      "tasks",
                      "results",
                      "submodules",
                      "paths",
                      "fields",
                      "filters",
                      "stats",
                      "effects",
                      "substitutions",
                      "findings",
                      "assumptions",
                      "subsystems",
                      "transitions",
                      "options",
                      "branches",
                      "agents",
                      "changes",
                      "failures",
                      "items",
                      "files",
                      "gaps",
                      "outcomes",
                      "body",
                      "query",
                      "repo",
                      "owner",
                      "number",
                      "title",
                      "branch",
                      "diff",
                      "limit",
                      "name",
                      "sha",
                      "url",
                      "head",
                      "base",
                      "ref",
                      "labels",
                      "path",
                      "cursor",
                      "cql",
                      "jql",
                      "description",
                      "assignee",
                      "depth",
                      "direction",
                      "summary",
                      "state",
                      "target",
                      "adr",
                      "type",
                      "mode",
                      "kind"
                    ],
                    "description": "Permitted single-word variable name."
                  }
                ],
                "description": "Parameter name within the routine body."
              },
              "description": {
                "type": "string",
                "description": "What the parameter is for, in the routine's own vocabulary."
              },
              "kind": {
                "type": "string",
                "const": "technique",
                "description": "Marks a technique-reference parameter, requiring a literal technique reference at each use or a declared default."
              },
              "default": {
                "type": [
                  "string",
                  "number",
                  "boolean"
                ],
                "description": "Value for an unbound argument; without a default, a value parameter uses the host variable of the same name."
              }
            },
            "required": [
              "id",
              "description"
            ],
            "additionalProperties": false,
            "description": "Routine parameter with an optional technique-reference kind and default."
          },
          "description": "Parameters for every value the body reads without producing itself."
        },
        "outputs": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "anyOf": [
                  {
                    "$ref": "#/definitions/routine/properties/inputs/items/properties/id/anyOf/0"
                  },
                  {
                    "$ref": "#/definitions/routine/properties/inputs/items/properties/id/anyOf/1"
                  }
                ],
                "description": "Output name within the routine body, bound to a session variable at each use."
              },
              "type": {
                "type": "string",
                "enum": [
                  "string",
                  "number",
                  "boolean",
                  "array",
                  "object"
                ],
                "description": "Type of the output and its bound session variable."
              },
              "description": {
                "type": "string",
                "description": "What the value is."
              },
              "values": {
                "type": "array",
                "items": {
                  "type": "string",
                  "description": "Allowed string output value."
                },
                "minItems": 1,
                "description": "Complete set of allowed values for a string output."
              },
              "optional": {
                "type": "boolean",
                "const": true,
                "description": "Declare `true` to allow this output to remain unbound; omission requires an output binding."
              }
            },
            "required": [
              "id",
              "type",
              "description"
            ],
            "additionalProperties": false,
            "description": "Produced value with its type, allowed values, and binding requirement."
          },
          "description": "Produced values, each declared with the type its bound session variable takes."
        },
        "internals": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "anyOf": [
                  {
                    "$ref": "#/definitions/routine/properties/inputs/items/properties/id/anyOf/0"
                  },
                  {
                    "$ref": "#/definitions/routine/properties/inputs/items/properties/id/anyOf/1"
                  }
                ],
                "description": "Name local to the routine body at each use, outside the workflow variable set."
              },
              "description": {
                "type": "string",
                "description": "What the value is, and which steps pass it."
              }
            },
            "required": [
              "id",
              "description"
            ],
            "additionalProperties": false,
            "description": "Named value shared by steps within one use of a routine."
          },
          "description": "Names for values shared between the routine's steps, local to each use."
        },
        "steps": {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "technique",
                    "description": "Step-kind discriminator."
                  },
                  "id": {
                    "type": "string",
                    "description": "Step identifier, defaulting to the last `::` segment of its technique reference."
                  },
                  "technique": {
                    "anyOf": [
                      {
                        "type": "string",
                        "description": "Technique reference using a `::`-separated path."
                      },
                      {
                        "type": "object",
                        "properties": {
                          "name": {
                            "type": "string",
                            "description": "Technique reference: `group::technique`, a bare technique name, or `workflow::group::technique`."
                          },
                          "inputs": {
                            "type": "object",
                            "additionalProperties": {
                              "type": [
                                "string",
                                "number",
                                "boolean"
                              ],
                              "description": "Variable name, literal value, or template expression for an input."
                            },
                            "description": "Input identifiers mapped to a source: the name of a session variable to read under that input, a literal, or a `{template}` expression. Declared only for inputs whose source differs from the same-name variable or the declared default."
                          },
                          "outputs": {
                            "type": "object",
                            "additionalProperties": {
                              "type": "string",
                              "description": "Workflow variable name for the output."
                            },
                            "description": "Output identifiers mapped to the workflow variable each value is written to. Declared only where that name differs from the output identifier."
                          }
                        },
                        "required": [
                          "name"
                        ],
                        "additionalProperties": false,
                        "description": "Technique reference with input and output bindings."
                      }
                    ],
                    "description": "Technique reference, or an object with `name` and optional `inputs` and `outputs` bindings."
                  },
                  "actions": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "action": {
                          "type": "string",
                          "enum": [
                            "log",
                            "validate",
                            "set",
                            "emit",
                            "message"
                          ],
                          "description": "Action for the executing agent to perform; a `set` value reaches the session when the agent reports it."
                        },
                        "target": {
                          "type": "string",
                          "description": "Variable name or other target of the action."
                        },
                        "message": {
                          "type": "string",
                          "description": "Message associated with the action."
                        },
                        "value": {
                          "description": "Value assigned or supplied by the action."
                        },
                        "description": {
                          "type": "string",
                          "description": "Human-readable description of what this action does"
                        },
                        "condition": {
                          "anyOf": [
                            {
                              "type": "object",
                              "properties": {
                                "type": {
                                  "type": "string",
                                  "const": "simple",
                                  "description": "Identifies a variable comparison or presence test."
                                },
                                "variable": {
                                  "type": "string",
                                  "description": "Variable name or dot-separated path to the value to test."
                                },
                                "operator": {
                                  "type": "string",
                                  "enum": [
                                    "==",
                                    "!=",
                                    ">",
                                    "<",
                                    ">=",
                                    "<=",
                                    "exists",
                                    "notExists"
                                  ],
                                  "description": "Comparison or presence test applied to a variable."
                                },
                                "value": {
                                  "type": [
                                    "string",
                                    "number",
                                    "boolean",
                                    "null"
                                  ],
                                  "description": "Comparison value; unnecessary for `exists` and `notExists` tests."
                                }
                              },
                              "required": [
                                "type",
                                "variable",
                                "operator"
                              ],
                              "additionalProperties": false,
                              "description": "Comparison of a variable with a value, or a test of its presence."
                            },
                            {
                              "type": "object",
                              "properties": {
                                "type": {
                                  "type": "string",
                                  "const": "and",
                                  "description": "Identifies an all-members condition."
                                },
                                "conditions": {
                                  "type": "array",
                                  "items": {
                                    "$ref": "#/definitions/routine/properties/steps/items/anyOf/0/properties/actions/items/properties/condition"
                                  },
                                  "minItems": 2,
                                  "description": "At least two conditions that must all be true."
                                }
                              },
                              "required": [
                                "type",
                                "conditions"
                              ],
                              "additionalProperties": false,
                              "description": "Condition requiring every member to be true."
                            },
                            {
                              "type": "object",
                              "properties": {
                                "type": {
                                  "type": "string",
                                  "const": "or",
                                  "description": "Identifies an any-member condition."
                                },
                                "conditions": {
                                  "type": "array",
                                  "items": {
                                    "$ref": "#/definitions/routine/properties/steps/items/anyOf/0/properties/actions/items/properties/condition"
                                  },
                                  "minItems": 2,
                                  "description": "At least two conditions, one or more of which must be true."
                                }
                              },
                              "required": [
                                "type",
                                "conditions"
                              ],
                              "additionalProperties": false,
                              "description": "Condition requiring at least one member to be true."
                            },
                            {
                              "type": "object",
                              "properties": {
                                "type": {
                                  "type": "string",
                                  "const": "not",
                                  "description": "Identifies a negated condition."
                                },
                                "condition": {
                                  "$ref": "#/definitions/routine/properties/steps/items/anyOf/0/properties/actions/items/properties/condition",
                                  "description": "Condition that must be false."
                                }
                              },
                              "required": [
                                "type",
                                "condition"
                              ],
                              "additionalProperties": false,
                              "description": "Condition requiring its member to be false."
                            }
                          ],
                          "description": "Condition that must be true for this action to execute"
                        }
                      },
                      "required": [
                        "action"
                      ],
                      "additionalProperties": false,
                      "description": "Action with an optional target, value, message, and condition."
                    },
                    "description": "Actions associated with the technique step."
                  },
                  "when": {
                    "$ref": "#/definitions/whenExpression",
                    "description": "Entry gate: the step runs only when this expression holds. On a checkpoint step, `condition`, not `when`, makes the checkpoint dismissible."
                  },
                  "required": {
                    "type": "boolean",
                    "const": false,
                    "description": "Declare `false` for an optional step; omission means the step is required, and `true` is rejected."
                  },
                  "condition": {
                    "$ref": "#/definitions/routine/properties/steps/items/anyOf/0/properties/actions/items/properties/condition",
                    "description": "Structured entry condition. Prefer `when` for a step gate. On a checkpoint step, `condition` is the only gate that makes the checkpoint dismissible: when it is false, the checkpoint may be dismissed as not met, and the activity takes its default exit."
                  }
                },
                "required": [
                  "kind",
                  "technique"
                ],
                "additionalProperties": false,
                "description": "Step that invokes a technique with optional actions and entry conditions."
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "action",
                    "description": "Step-kind discriminator."
                  },
                  "id": {
                    "type": "string",
                    "description": "Identifier for this step within the activity."
                  },
                  "actions": {
                    "type": "array",
                    "items": {
                      "$ref": "#/definitions/routine/properties/steps/items/anyOf/0/properties/actions/items"
                    },
                    "description": "Control actions; may be empty for marker steps."
                  },
                  "when": {
                    "$ref": "#/definitions/routine/properties/steps/items/anyOf/0/properties/when"
                  },
                  "required": {
                    "$ref": "#/definitions/routine/properties/steps/items/anyOf/0/properties/required"
                  },
                  "condition": {
                    "$ref": "#/definitions/routine/properties/steps/items/anyOf/0/properties/condition"
                  }
                },
                "required": [
                  "kind",
                  "id"
                ],
                "additionalProperties": false,
                "description": "Control step with optional actions and entry conditions."
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "checkpoint",
                    "description": "Step-kind discriminator."
                  },
                  "id": {
                    "type": "string",
                    "description": "Identifier for this checkpoint within the activity, and the key its recorded responses replay under on resume."
                  },
                  "message": {
                    "type": "string",
                    "description": "Message presented to the user."
                  },
                  "options": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string",
                          "description": "Option identifier within the checkpoint."
                        },
                        "label": {
                          "type": "string",
                          "description": "Short label for the choice."
                        },
                        "description": {
                          "type": "string",
                          "description": "Explanation of the choice."
                        },
                        "effect": {
                          "type": "object",
                          "properties": {
                            "setVariable": {
                              "type": "object",
                              "additionalProperties": {
                                "description": "Value assigned to the named variable."
                              },
                              "description": "Variable assignments applied when this option is selected. Each value is checked against the variable's declared type and value set, and a mismatch is stored as written with a warning; a `{name}` template value passes through unchecked."
                            },
                            "exit": {
                              "type": "string",
                              "description": "Exit of the owning activity this option selects: a name from its `exits`, never an activity identifier. Omitted for an ad hoc checkpoint, which has no declared exits."
                            }
                          },
                          "additionalProperties": false,
                          "description": "Variable assignments and activity exit associated with the choice."
                        }
                      },
                      "required": [
                        "id",
                        "label"
                      ],
                      "additionalProperties": false,
                      "description": "Checkpoint choice and its associated effects."
                    },
                    "minItems": 1,
                    "description": "Decision options with effects."
                  },
                  "defaultOption": {
                    "type": "string",
                    "description": "Option identifier to use when no person answers the checkpoint."
                  },
                  "autoAdvanceMs": {
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "description": "Positive waiting interval in milliseconds before the default option may be selected automatically."
                  },
                  "when": {
                    "$ref": "#/definitions/routine/properties/steps/items/anyOf/0/properties/when"
                  },
                  "required": {
                    "$ref": "#/definitions/routine/properties/steps/items/anyOf/0/properties/required"
                  },
                  "condition": {
                    "$ref": "#/definitions/routine/properties/steps/items/anyOf/0/properties/condition"
                  }
                },
                "required": [
                  "kind",
                  "id",
                  "message",
                  "options"
                ],
                "additionalProperties": false,
                "description": "User decision at a defined position in the activity steps."
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "loop",
                    "description": "Step-kind discriminator."
                  },
                  "id": {
                    "type": "string",
                    "description": "Identifier for this step within the activity."
                  },
                  "name": {
                    "type": "string",
                    "description": "Human-readable label for the iteration."
                  },
                  "loopType": {
                    "type": "string",
                    "enum": [
                      "forEach",
                      "while",
                      "doWhile"
                    ],
                    "description": "Iteration over a collection (`forEach`), with a pre-test (`while`), or with a post-test (`doWhile`)."
                  },
                  "continueWhile": {
                    "$ref": "#/definitions/routine/properties/steps/items/anyOf/0/properties/actions/items/properties/condition",
                    "description": "Continuation condition required for `while` and `doWhile` loops and absent for `forEach` loops."
                  },
                  "variable": {
                    "type": "string",
                    "description": "Current-item variable bound each iteration of a `forEach` loop; absent for `while` and `doWhile` loops."
                  },
                  "over": {
                    "type": "string",
                    "description": "Collection a `forEach` loop iterates: a variable name or a dotted path into one; absent for `while` and `doWhile` loops."
                  },
                  "breakCondition": {
                    "$ref": "#/definitions/routine/properties/steps/items/anyOf/0/properties/actions/items/properties/condition",
                    "description": "Condition that ends a `forEach` loop before the next item; absent for `while` and `doWhile` loops."
                  },
                  "maxIterations": {
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "description": "Maximum number of iterations."
                  },
                  "steps": {
                    "type": "array",
                    "items": {
                      "$ref": "#/definitions/routine/properties/steps/items",
                      "description": "Step within the loop body."
                    },
                    "description": "The loop body, a nested ordered list of steps."
                  },
                  "when": {
                    "$ref": "#/definitions/routine/properties/steps/items/anyOf/0/properties/when"
                  },
                  "required": {
                    "$ref": "#/definitions/routine/properties/steps/items/anyOf/0/properties/required"
                  }
                },
                "required": [
                  "kind",
                  "id",
                  "loopType",
                  "steps"
                ],
                "additionalProperties": false,
                "description": "Loop over a collection or until a continuation test fails, entered when its `when` expression holds."
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "routine",
                    "description": "Step-kind discriminator."
                  },
                  "id": {
                    "type": "string",
                    "description": "Routine step identifier and prefix for identifiers within its body."
                  },
                  "routine": {
                    "type": "string",
                    "description": "Routine reference in `[namespace::]name` form. The namespace is a directory name, or the path from the corpus root reaching it. A qualified name resolves in that namespace only; a bare name resolves against the referring activity's source workflow, then `meta`. The last segment is the routine and every segment before it is the namespace, since a routine name has no group grammar."
                  },
                  "with": {
                    "type": "object",
                    "additionalProperties": {
                      "type": [
                        "string",
                        "number",
                        "boolean"
                      ],
                      "description": "Literal argument or braced host-variable reference."
                    },
                    "description": "Routine input identifiers mapped to arguments: a braced value (`{host_variable}`) references a host variable, and any other value is a literal. An input left unbound takes its declared default, then the host variable of the same name; a `kind: technique` input left unbound with no default fails the load."
                  },
                  "outputs": {
                    "type": "object",
                    "additionalProperties": {
                      "type": "string",
                      "description": "Session variable name for the routine output."
                    },
                    "description": "Routine output identifiers mapped to session variable names. An output left unbound produces no write; only an output declared `optional: true` may be left unbound, and any other unbound output fails the load."
                  },
                  "when": {
                    "$ref": "#/definitions/routine/properties/steps/items/anyOf/0/properties/when"
                  },
                  "required": {
                    "$ref": "#/definitions/routine/properties/steps/items/anyOf/0/properties/required"
                  }
                },
                "required": [
                  "kind",
                  "id",
                  "routine"
                ],
                "additionalProperties": false,
                "description": "Routine invocation with argument and output bindings, entered when its `when` expression holds."
              }
            ],
            "description": "Step selected by `kind`; its guidance lives in the bound technique."
          },
          "minItems": 1,
          "description": "Nonempty ordered list of steps."
        }
      },
      "required": [
        "id",
        "version",
        "name",
        "steps"
      ],
      "additionalProperties": false,
      "description": "Reusable steps with declared inputs, outputs, and internals."
    }
  }
}
