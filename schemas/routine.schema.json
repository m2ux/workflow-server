{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "routine",
  "description": "Routine definition schema — a named run of steps declaring its inputs, outputs and internals, materialised into the activity that refers to it.",
  "$ref": "#/definitions/routine",
  "definitions": {
    "routine": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$",
          "description": "Unique identifier for the routine, and the name a reference resolves."
        },
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$",
          "description": "Semantic version of the routine"
        },
        "name": {
          "type": "string",
          "description": "Human-readable routine name"
        },
        "description": {
          "type": "string",
          "description": "What the run does, and when to refer to it"
        },
        "inputs": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9]*(_[a-z0-9]+)+$"
                  },
                  {
                    "type": "string",
                    "enum": [
                      "requirements",
                      "features",
                      "exclusions",
                      "dimensions",
                      "tasks",
                      "results",
                      "submodules",
                      "paths",
                      "fields",
                      "filters",
                      "stats",
                      "effects",
                      "substitutions",
                      "findings",
                      "assumptions",
                      "subsystems",
                      "transitions",
                      "options",
                      "branches",
                      "agents",
                      "changes",
                      "failures",
                      "items",
                      "files",
                      "gaps",
                      "outcomes",
                      "body",
                      "query",
                      "repo",
                      "owner",
                      "number",
                      "title",
                      "branch",
                      "diff",
                      "limit",
                      "name",
                      "sha",
                      "url",
                      "head",
                      "base",
                      "ref",
                      "labels",
                      "path",
                      "cursor",
                      "cql",
                      "jql",
                      "description",
                      "assignee",
                      "depth",
                      "direction",
                      "summary",
                      "state",
                      "target",
                      "adr",
                      "type",
                      "mode",
                      "kind"
                    ]
                  }
                ],
                "description": "The name this parameter carries inside the body, and the name an unbound site falls through to in the host's bag."
              },
              "description": {
                "type": "string",
                "description": "What the parameter is for, in the routine's own vocabulary."
              },
              "kind": {
                "type": "string",
                "const": "technique",
                "description": "Declared where the argument is a technique reference standing in a body step's technique position. A reference site binds it with a literal reference, and an unbound one with no default fails the load."
              },
              "default": {
                "type": [
                  "string",
                  "number",
                  "boolean"
                ],
                "description": "The value the body takes where a reference site binds nothing. Without one, an unbound input reads the host's value under this id."
              }
            },
            "required": [
              "id",
              "description"
            ],
            "additionalProperties": false
          },
          "description": "Declared parameters. Every name the body reads that it does not write is one of these."
        },
        "outputs": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "anyOf": [
                  {
                    "$ref": "#/definitions/routine/properties/inputs/items/properties/id/anyOf/0"
                  },
                  {
                    "$ref": "#/definitions/routine/properties/inputs/items/properties/id/anyOf/1"
                  }
                ],
                "description": "The name this value carries inside the body. A reference site binds it to the session variable its value lands under."
              },
              "type": {
                "type": "string",
                "enum": [
                  "string",
                  "number",
                  "boolean",
                  "array",
                  "object"
                ],
                "description": "Declared type, carried onto the session variable the reference site binds this output to."
              },
              "description": {
                "type": "string",
                "description": "What the value is."
              },
              "values": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "minItems": 1,
                "description": "The complete set of values a string output admits, carried onto the bound session variable."
              },
              "optional": {
                "type": "boolean",
                "const": true,
                "description": "Declared only when a reference site may leave this output unbound, which drops the bindings that write it. Leaving an unmarked output unbound fails the load."
              }
            },
            "required": [
              "id",
              "type",
              "description"
            ],
            "additionalProperties": false
          },
          "description": "Declared produced values, each a full variable declaration bound to a session variable at the point of use."
        },
        "internals": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "anyOf": [
                  {
                    "$ref": "#/definitions/routine/properties/inputs/items/properties/id/anyOf/0"
                  },
                  {
                    "$ref": "#/definitions/routine/properties/inputs/items/properties/id/anyOf/1"
                  }
                ],
                "description": "The name this value carries inside the body. Materialised per host activity and per reference site, and never a workflow variable."
              },
              "description": {
                "type": "string",
                "description": "What the value is, and which steps pass it."
              }
            },
            "required": [
              "id",
              "description"
            ],
            "additionalProperties": false
          },
          "description": "Names the body's steps pass between themselves, which never enter the workflow variable set."
        },
        "steps": {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "technique",
                    "description": "Step-kind discriminator."
                  },
                  "id": {
                    "type": "string",
                    "description": "Identifier for this step within the activity. Optional: the loader derives it from the last `::` segment of the technique name."
                  },
                  "technique": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "object",
                        "properties": {
                          "name": {
                            "type": "string",
                            "description": "The `group::technique` (or bare op / `workflow::group::op`) technique reference this step invokes."
                          },
                          "inputs": {
                            "type": "object",
                            "additionalProperties": {
                              "type": [
                                "string",
                                "number",
                                "boolean"
                              ]
                            },
                            "description": "Input deviations: op input id → source expression (rename of a bag variable, literal, or `{template}`). Only what differs from same-name binding or a declared default."
                          },
                          "outputs": {
                            "type": "object",
                            "additionalProperties": {
                              "type": "string"
                            },
                            "description": "Output remaps: op output id → the workflow variable name its produced value lands under, when it differs from the output id."
                          }
                        },
                        "required": [
                          "name"
                        ],
                        "additionalProperties": false
                      }
                    ],
                    "description": "Canonical per-step binding: a `group::technique` reference (string) for a step with no deviations, or `{ name, inputs?, outputs? }` when the step supplies input deviations or output remaps."
                  },
                  "actions": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "action": {
                          "type": "string",
                          "enum": [
                            "log",
                            "validate",
                            "set",
                            "emit",
                            "message"
                          ],
                          "description": "Action verb, interpreted by the executing agent. The server has no action interpreter: executing `set` is the worker's job, and its value reaches the session variable bag when the worker reports it in the `variables_changed` its orchestrator relays on next_activity. `set` is slated for removal at the next workflow-schema major (#166 B7/B12)."
                        },
                        "target": {
                          "type": "string"
                        },
                        "message": {
                          "type": "string"
                        },
                        "value": {},
                        "description": {
                          "type": "string",
                          "description": "Human-readable description of what this action does"
                        },
                        "condition": {
                          "anyOf": [
                            {
                              "type": "object",
                              "properties": {
                                "type": {
                                  "type": "string",
                                  "const": "simple"
                                },
                                "variable": {
                                  "type": "string"
                                },
                                "operator": {
                                  "type": "string",
                                  "enum": [
                                    "==",
                                    "!=",
                                    ">",
                                    "<",
                                    ">=",
                                    "<=",
                                    "exists",
                                    "notExists"
                                  ]
                                },
                                "value": {
                                  "type": [
                                    "string",
                                    "number",
                                    "boolean",
                                    "null"
                                  ]
                                }
                              },
                              "required": [
                                "type",
                                "variable",
                                "operator"
                              ],
                              "additionalProperties": false
                            },
                            {
                              "type": "object",
                              "properties": {
                                "type": {
                                  "type": "string",
                                  "const": "and"
                                },
                                "conditions": {
                                  "type": "array",
                                  "items": {
                                    "$ref": "#/definitions/routine/properties/steps/items/anyOf/0/properties/actions/items/properties/condition"
                                  },
                                  "minItems": 2
                                }
                              },
                              "required": [
                                "type",
                                "conditions"
                              ],
                              "additionalProperties": false
                            },
                            {
                              "type": "object",
                              "properties": {
                                "type": {
                                  "type": "string",
                                  "const": "or"
                                },
                                "conditions": {
                                  "type": "array",
                                  "items": {
                                    "$ref": "#/definitions/routine/properties/steps/items/anyOf/0/properties/actions/items/properties/condition"
                                  },
                                  "minItems": 2
                                }
                              },
                              "required": [
                                "type",
                                "conditions"
                              ],
                              "additionalProperties": false
                            },
                            {
                              "type": "object",
                              "properties": {
                                "type": {
                                  "type": "string",
                                  "const": "not"
                                },
                                "condition": {
                                  "$ref": "#/definitions/routine/properties/steps/items/anyOf/0/properties/actions/items/properties/condition"
                                }
                              },
                              "required": [
                                "type",
                                "condition"
                              ],
                              "additionalProperties": false
                            }
                          ],
                          "description": "Condition that must be true for this action to execute"
                        }
                      },
                      "required": [
                        "action"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "when": {
                    "type": "string",
                    "description": "Inline boolean expression that gates this step. Operators: ==, !=, >, <, >=, <=, bare identifier truthiness, unary !, &&, ||, and parentheses. Precedence (C-style, tightest first): () > ! > comparisons > && > ||. Mixing && and || at the same nesting depth requires parentheses. Examples: \"has_saved_state == true\", \"remediation_round > 0\", \"a == true && b != false\", \"(a && b) || c\", \"is_review_mode != true && (problem_complexity == \\\"moderate\\\" || problem_complexity == \\\"complex\\\")\". Evaluated by the executing agent against current variable state; the server never evaluates gates. Mechanical nets (e2e walker, guards) use the shared reference evaluator and treat invalid expressions as false (step does not run). On a checkpoint step, only `condition` (not `when`) enables condition_not_met dismissal."
                  },
                  "required": {
                    "type": "boolean",
                    "const": false,
                    "description": "Declared only when false (an optional step). An omitted `required` means the step is required; `required: true` is redundant and rejected (AP-64). A worker hint — the server does not check it."
                  },
                  "condition": {
                    "$ref": "#/definitions/routine/properties/steps/items/anyOf/0/properties/actions/items/properties/condition",
                    "description": "LEGACY: Structured condition that must be true for this step to execute, evaluated by the executing agent. Prefer the `when` inline expression for simple comparisons — except on a checkpoint step, where the `condition` field is what makes the checkpoint dismissible via respond_checkpoint condition_not_met."
                  }
                },
                "required": [
                  "kind",
                  "technique"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "action",
                    "description": "Step-kind discriminator."
                  },
                  "id": {
                    "type": "string",
                    "description": "Identifier for this step within the activity."
                  },
                  "actions": {
                    "type": "array",
                    "items": {
                      "$ref": "#/definitions/routine/properties/steps/items/anyOf/0/properties/actions/items"
                    },
                    "description": "Control actions; may be empty for marker steps."
                  },
                  "when": {
                    "$ref": "#/definitions/routine/properties/steps/items/anyOf/0/properties/when"
                  },
                  "required": {
                    "$ref": "#/definitions/routine/properties/steps/items/anyOf/0/properties/required"
                  },
                  "condition": {
                    "$ref": "#/definitions/routine/properties/steps/items/anyOf/0/properties/condition"
                  }
                },
                "required": [
                  "kind",
                  "id"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "checkpoint",
                    "description": "Step-kind discriminator."
                  },
                  "id": {
                    "type": "string",
                    "description": "Identifier for this step within the activity; the stable checkpoint-response replay key."
                  },
                  "message": {
                    "type": "string",
                    "description": "Message presented to the user."
                  },
                  "options": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string"
                        },
                        "label": {
                          "type": "string"
                        },
                        "description": {
                          "type": "string"
                        },
                        "effect": {
                          "type": "object",
                          "properties": {
                            "setVariable": {
                              "type": "object",
                              "additionalProperties": {},
                              "description": "Variable assignments the server applies to the session variable bag when the option is selected — the one engine-applied checkpoint effect. Values are validated against the declared variable type, warn-only: mismatches are stored as written and surfaced in _meta.validation; `{name}` template passthroughs are exempt."
                            },
                            "exit": {
                              "type": "string",
                              "description": "Exit of the owning activity this option selects — a name from the activity's `exits[]`, never an activity id. The destination is the workflow's to state: `present_checkpoint` reads it from the workflow graph so the option's consequence is stated before the user chooses. An adhoc checkpoint has no declared exits, so its options carry setVariable only."
                            }
                          },
                          "additionalProperties": false
                        }
                      },
                      "required": [
                        "id",
                        "label"
                      ],
                      "additionalProperties": false
                    },
                    "minItems": 1,
                    "description": "Decision options with effects."
                  },
                  "defaultOption": {
                    "type": "string",
                    "description": "The answer a soft gate takes when no person is reached."
                  },
                  "autoAdvanceMs": {
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "description": "The interval the server spends before applying a soft gate's default on respond_checkpoint { auto_advance: true }."
                  },
                  "when": {
                    "$ref": "#/definitions/routine/properties/steps/items/anyOf/0/properties/when"
                  },
                  "required": {
                    "$ref": "#/definitions/routine/properties/steps/items/anyOf/0/properties/required"
                  },
                  "condition": {
                    "$ref": "#/definitions/routine/properties/steps/items/anyOf/0/properties/condition"
                  }
                },
                "required": [
                  "kind",
                  "id",
                  "message",
                  "options"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "loop",
                    "description": "Step-kind discriminator."
                  },
                  "id": {
                    "type": "string",
                    "description": "Identifier for this step within the activity."
                  },
                  "name": {
                    "type": "string",
                    "description": "Structural label for the iteration (the one step kind that carries a name)."
                  },
                  "loopType": {
                    "type": "string",
                    "enum": [
                      "forEach",
                      "while",
                      "doWhile"
                    ],
                    "description": "Iteration type. `forEach` walks a collection; `while` takes its continuation test before the first pass; `doWhile` takes it after."
                  },
                  "continueWhile": {
                    "$ref": "#/definitions/routine/properties/steps/items/anyOf/0/properties/actions/items/properties/condition",
                    "description": "The continuation test of a while/doWhile loop: the body runs again while this holds. Declared by every repeat-until loop and by no forEach, whose iteration is bounded by its collection. Evaluated by the executing agent; `loopType` says when it is taken."
                  },
                  "variable": {
                    "type": "string",
                    "description": "Current-item variable bound each iteration."
                  },
                  "over": {
                    "type": "string",
                    "description": "Collection expression iterated by a forEach loop."
                  },
                  "breakCondition": {
                    "$ref": "#/definitions/routine/properties/steps/items/anyOf/0/properties/actions/items/properties/condition",
                    "description": "Early exit from item iteration, evaluated by the executing agent before each item: iteration stops when it holds. A repeat-until loop states its stopping condition in `continueWhile` instead."
                  },
                  "maxIterations": {
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "description": "Safety bound on iteration count, enforced by the executing agent."
                  },
                  "steps": {
                    "type": "array",
                    "items": {
                      "$ref": "#/definitions/routine/properties/steps/items"
                    },
                    "description": "The loop body, a nested ordered list of steps."
                  },
                  "when": {
                    "$ref": "#/definitions/routine/properties/steps/items/anyOf/0/properties/when"
                  },
                  "required": {
                    "$ref": "#/definitions/routine/properties/steps/items/anyOf/0/properties/required"
                  }
                },
                "required": [
                  "kind",
                  "id",
                  "loopType",
                  "steps"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "routine",
                    "description": "Step-kind discriminator."
                  },
                  "id": {
                    "type": "string",
                    "description": "Identifier for this step within the activity, and the prefix every identifier in the materialised body carries."
                  },
                  "routine": {
                    "type": "string",
                    "description": "Routine reference: `[namespace::]name`, the namespace spelled by its directory name or by the path from the corpus root reaching it. A qualified name resolves in that namespace only; a bare name resolves against the referring activity's source workflow and then meta. The last segment is the routine and every segment before it belongs to the namespace — a routine name carries no group grammar."
                  },
                  "with": {
                    "type": "object",
                    "additionalProperties": {
                      "type": [
                        "string",
                        "number",
                        "boolean"
                      ]
                    },
                    "description": "Arguments: routine input id → the value it takes here. A braced value is a reference to a host variable and a bare value is a literal. A declared input left unbound takes the host's value under the input's own id, or the input's declared default."
                  },
                  "outputs": {
                    "type": "object",
                    "additionalProperties": {
                      "type": "string"
                    },
                    "description": "Output bindings: routine output id → the session variable its value lands under. An output the site leaves unbound produces no write, and its declaration says whether that is allowed."
                  },
                  "when": {
                    "$ref": "#/definitions/routine/properties/steps/items/anyOf/0/properties/when"
                  },
                  "required": {
                    "$ref": "#/definitions/routine/properties/steps/items/anyOf/0/properties/required"
                  }
                },
                "required": [
                  "kind",
                  "id",
                  "routine"
                ],
                "additionalProperties": false
              }
            ]
          },
          "minItems": 1,
          "description": "The run, an ordered list of kind-tagged steps. A routine with no steps is a signature with nothing behind it."
        }
      },
      "required": [
        "id",
        "version",
        "name",
        "steps"
      ],
      "additionalProperties": false
    }
  }
}
